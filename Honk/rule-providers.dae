# Remote source declarations only; routing actions are in routing.dae.
rule_set {
    my-direct {
        url: 'https://raw.githubusercontent.com/mitcehub/MyRule/main/Honk/remote/Direct.list'
        format: text
        behavior: classical
        route: '🇭🇰 港台自动'
        interval: 86400
    }
    my-proxy {
        url: 'https://raw.githubusercontent.com/mitcehub/MyRule/main/Honk/remote/Proxy.list'
        format: text
        behavior: classical
        route: '🇭🇰 港台自动'
        interval: 86400
    }
    my-ai {
        url: 'https://raw.githubusercontent.com/mitcehub/MyRule/main/Honk/remote/AI.list'
        format: text
        behavior: classical
        route: '🇭🇰 港台自动'
        interval: 86400
    }
}
