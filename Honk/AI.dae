# Requires Honk with remote rule_set support; not a static matcher list.
rule_set {
    my-ai {
        url: 'https://raw.githubusercontent.com/mitcehub/MyRule/main/Honk/remote/AI.list'
        format: text
        behavior: classical
        route: '🇭🇰 港台自动'
        interval: 86400
    }
}
routing {
    rule_set('my-ai') -> 🤖 ChatGPT
}
