# Requires Honk with remote rule_set support; not a static matcher list.
rule_set {
    my-proxy {
        url: 'https://raw.githubusercontent.com/mitcehub/MyRule/main/Honk/remote/Proxy.list'
        format: text
        behavior: classical
        route: '🇭🇰 港台自动'
        interval: 86400
    }
}
routing {
    rule_set('my-proxy') -> 🚀 节点选择
}
