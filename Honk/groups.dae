# Node-free groups. Region filters follow node names from native subscriptions.
group {
    🟢 直连 {
        filter: name('direct')
        policy: select
        default: 'direct'
    }
    🚀 节点选择 {
        filter: group('♻️ 自动选择', '🇭🇰 港台自动', '🇯🇵 日本自动', '🇸🇬 新加坡自动', '🇺🇸 美国自动', '🟢 直连', '🛫 机场01', '🛫 机场02', '🛫 机场04', '🛫 机场05')
        policy: select
        default: '♻️ 自动选择'
    }
    ♻️ 自动选择 {
        filter: !name(regex: '(?i)(直连|官网|更新|失联|剩余|到期|套餐|重置|群|IEPL|3x|4x|5x|流量用完|订阅信息)')
        policy: min_moving_avg
    }
    🇭🇰 港台自动 {
        filter: name(regex: '(?i)(香港|港|台湾|🇭🇰|hk|taiwan|hong)') && !name(regex: '(?i)(3x|4x|5x|剩余流量|流量用完|套餐|到期|重置|官网|订阅信息)')
        policy: min_moving_avg
    }
    🇯🇵 日本自动 {
        filter: name(regex: '(?i)(日本|东京|🇯🇵|jp|japan)') && !name(regex: '(?i)(3x|4x|5x|剩余流量|流量用完|套餐|到期|重置|官网|订阅信息)')
        policy: min_moving_avg
    }
    🇰🇷 韩国自动 {
        filter: name(regex: '(?i)(韩国|韩|🇰🇷|kr|korea)') && !name(regex: '(?i)(3x|4x|5x|剩余流量|流量用完|套餐|到期|重置|官网|订阅信息)')
        policy: min_moving_avg
    }
    🇸🇬 新加坡自动 {
        filter: name(regex: '(?i)(新加坡|星|🇸🇬|sg|singapore)') && !name(regex: '(?i)(3x|4x|5x|剩余流量|流量用完|套餐|到期|重置|官网|订阅信息)')
        policy: min_moving_avg
    }
    🇺🇸 美国自动 {
        filter: name(regex: '(?i)(美国|美|凤凰城|🇺🇲|us|states|america)') && !name(regex: '(?i)(3x|4x|5x|剩余流量|流量用完|套餐|到期|重置|官网|订阅信息)')
        policy: min_moving_avg
    }
    🤖 ChatGPT {
        filter: group('🇸🇬 新加坡自动', '🇯🇵 日本自动', '🇰🇷 韩国自动', '🇺🇸 美国自动')
        policy: select
        default: '🇸🇬 新加坡自动'
    }
    🏞️ Instagram {
        filter: group('🇸🇬 新加坡自动', '🇯🇵 日本自动', '🇰🇷 韩国自动', '🇺🇸 美国自动')
        policy: select
        default: '🇸🇬 新加坡自动'
    }
    🎵 TikTok {
        filter: group('🇺🇸 美国自动', '🇸🇬 新加坡自动', '🇯🇵 日本自动', '🇰🇷 韩国自动')
        policy: select
        default: '🇺🇸 美国自动'
    }
    🪟 Microsoft {
        filter: group('🟢 直连', '🇺🇸 美国自动', '🇯🇵 日本自动', '🇰🇷 韩国自动')
        policy: select
        default: '🟢 直连'
    }
    🍏 Apple {
        filter: group('🟢 直连', '🚀 节点选择')
        policy: select
        default: '🟢 直连'
    }
    🐠 漏网之鱼 {
        filter: group('🟢 直连', '🚀 节点选择')
        policy: select
        default: '🟢 直连'
    }
    🛫 机场01 {
        filter: subtag('Airport_01') && !name(regex: '(?i)(剩余流量|流量用完|套餐|到期|重置|官网|订阅信息)')
        policy: min_moving_avg
    }
    🛫 机场02 {
        filter: subtag('Airport_02') && !name(regex: '(?i)(剩余流量|流量用完|套餐|到期|重置|官网|订阅信息)')
        policy: min_moving_avg
    }
    🛫 机场04 {
        filter: subtag('Airport_04') && !name(regex: '(?i)(剩余流量|流量用完|套餐|到期|重置|官网|订阅信息)')
        policy: min_moving_avg
    }
    🛫 机场05 {
        filter: subtag('Airport_05') && !name(regex: '(?i)(剩余流量|流量用完|套餐|到期|重置|官网|订阅信息)')
        policy: min_moving_avg
    }
}
