rule_set {
    my-direct {
        url: 'https://raw.githubusercontent.com/mitcehub/MyRule/main/Honk/remote/Direct.list'
        format: text
        behavior: classical
        route: direct
        interval: 86400
    }
    my-proxy {
        url: 'https://raw.githubusercontent.com/mitcehub/MyRule/main/Honk/remote/Proxy.list'
        format: text
        behavior: classical
        route: direct
        interval: 86400
    }
    my-ai {
        url: 'https://raw.githubusercontent.com/mitcehub/MyRule/main/Honk/remote/AI.list'
        format: text
        behavior: classical
        route: direct
        interval: 86400
    }
}

routing {
    rule_set('my-direct') -> direct
    rule_set('my-proxy') -> 🚀 节点选择
    rule_set('my-ai') -> 🤖 ChatGPT
}
