# No nodes or credentials. Download the included files before starting Honk.
# Put private subscription entries in subscriptions.dae; manage those locally.
include {
    system.dae
    subscriptions.dae
    groups.dae
    rules/local.dae
    rules/Direct.dae
    rules/Proxy.dae
    rules/AI.dae
    rules/public.dae
}

dns {
    upstream {
        default: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com' -> direct
        remote: 'https://8.8.8.8/dns-query?tls_server_name=dns.google' -> Proxy
    }
    routing {
        request {
            qname(geosite: private) -> asis
            qname(geosite: cn) -> default
            fallback: remote
        }
    }
}
